package pages

import(
    "ki/src/config"
    "ki/src/pkg/bytes"
    "ki/src/ui/formkeys"
    "ki/src/ui"
)

templ e2eOptions(view *PageUploadView ) {

    <br/>
    <h1>E2E options</h1>
    <br/>

    <pre class="my-2" title="GPG command to encrypt a file with a password">
        <textarea class="w-full" rows="1">
            gpg -c your_file.txt
        </textarea>
    </pre>

    <pre class="my-2" title="7-Zip command to encrypt a file with a password">
        <textarea class="w-full" rows="1">
            7z a output.7z -pyour_password your_file.txt
        </textarea>
    </pre>
}

script formUploadScript() {

    document.addEventListener('DOMContentLoaded', () => {

        const form = document.querySelector('form[action="/api/upload"]');

        if (!form) {
            return;
        }

        form.addEventListener('submit', (event) => {
            event.preventDefault();

            const formData = new FormData(form);
            const xhr = new XMLHttpRequest();
            const startTime = Date.now();

            const cont = document.createElement('div');
            cont.style.display = 'flex';
            cont.style.alignItems = 'center';
            cont.style.justifyContent = 'center';
            cont.style.gap = '10px';

            const prog = document.createElement('div');
            prog.style.whiteSpace = 'pre';
            prog.style.fontFamily = 'monospace';

            const cancel = document.createElement('button');
            cancel.type = 'button';
            cancel.textContent = 'Cancel';
            cancel.style.cursor = 'pointer';
            cancel.onclick = () => {
                xhr.abort();
                cont.remove();
            };

            cont.appendChild(prog);
            cont.appendChild(cancel);
            form.parentElement.insertBefore(cont, form);

            xhr.open(form.method, form.action, true);
            xhr.setRequestHeader('X-Requested-With', 'js-form');

            xhr.upload.onprogress = (e) => {
                if (!e.lengthComputable) {
                    return;
                }
                const percent = ((e.loaded / e.total) * 100).toFixed(1);
                const rateBps = (e.loaded / ((Date.now() - startTime) / 1000)) / 1024;
                const rateStr = (rateBps > 1024) ? (rateBps / (1024)).toFixed(2) + ' MB/s' : (rateBps).toFixed(1) + ' KB/s'
                prog.textContent = `${e.loaded} / ${e.total} bytes (${percent}%) @ ${rateStr}`;
            };

            xhr.onload = () => {
                const location = xhr.getResponseHeader('Location');
                if (location && xhr.status === 200) {
                    window.location.href = location;
                } else {
                    alert('Upload failed: ' + xhr.status);
                }
            };

            xhr.onerror = () => {
                alert('Network error during upload.');
            };

            xhr.send(formData);
        });
    });
}

templ PageUpload(view *PageUploadView) {

    @Base(&view.BaseView) {

        @formUploadScript()

        <br/>
        <h1>Upload a file</h1>
        <h3>File must be less than { bytes.PrettyByteSize64(config.MaxUploadSize()) } </h3>
        <br/>

        <form enctype="multipart/form-data" action="/api/upload" method="POST">

            @ui.CSRF(view.R)

            <table class="table-auto table-padded">

            <tbody class="text-right">

                <tr title="Expire after this many days">
                    <td class="px-2"> Days </td>
                    <td> <input class="w-full" type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_DAYS } value="0" min="0" required> </td>
                </tr>
                <tr title="Expire after this many hours">
                    <td class="px-2"> Hours </td>
                    <td> <input class="w-full" type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_HOURS } value="1" min="0" required> </td>
                </tr>
                <tr title="Expire after this many minutes">
                    <td class="px-2"> Minutes </td>
                    <td> <input class="w-full" type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_MINUTES } value="0" min="0" required> </td>
                </tr>
                <tr title="Expired after this many downloads">
                    <td class="px-2"> Downloads </td>
                    <td> <input class="w-full" type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_DOWNLOADS } value="1" min="1" required> </td>
                </tr>
                <tr title="Never write file metadata to disk (file will expire if server restarts or crashes)">
                    <td class="px-2"> Memory Only </td>
                    <td> 
                        <select class="w-full" name={ formkeys.UPLOAD_FORM_MEMORY_ONLY }>
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </td>
                </tr>
                <tr title="Require this password to download the file">
                    <td class="px-2"> Password (Optional) </td>
                    <td> <input class="w-full" type="password" name={ formkeys.UPLOAD_FORM_PASSWORD }> </td>
                </tr>
                <tr title="Choose the file to upload">
                    <td colspan="2"> 
                        <input class="w-full" type="file" name={ formkeys.UPLOAD_FORM_FILE } required>
                    </td>
                </tr>
                <tr title="Upload the selected file">
                    <td colspan="2"> 
                        <input class="w-full" type="submit" value="Upload">
                    </td>
                </tr>

            </tbody>

            </table>
                        
        </form>

        @e2eOptions(view)
    }
}

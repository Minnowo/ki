package pages

import(
"fmt"
"ki/src/config"
"ki/src/handlers/str"
"ki/src/ui/formkeys"
)

templ e2eOptions(view *PageUploadView ) {

    <br/>
    <h1>E2E options</h1>
    <br/>

    <pre class="my-2" title="GPG command to encrypt a file with a password">
        <textarea class="w-full" rows="1">
            gpg -c your_file.txt
        </textarea>
    </pre>

    <pre class="my-2" title="7-Zip command to encrypt a file with a password">
        <textarea class="w-full" rows="1">
            7z a output.7z -pyour_password your_file.txt
        </textarea>
    </pre>
}

templ otherUploadOptions(view *PageUploadView ) {

    {{
        dl := view.Origin + "/api/upload"

        curlCmd := fmt.Sprint("curl -Ls -H \"Content-Type: multipart/form-data\" ", dl, 
            " -o upload -w \"\\n%{url_effective}\\n\" ",
            " -F ", formkeys.UPLOAD_FORM_EXPIRE_DAYS, "=\"0\"",
            " -F ", formkeys.UPLOAD_FORM_EXPIRE_HOURS, "=\"1\"",
            " -F ", formkeys.UPLOAD_FORM_EXPIRE_MINUTES, "=\"0\"",
            " -F ", formkeys.UPLOAD_FORM_EXPIRE_DOWNLOADS, "=\"1\"",
            " -F ", formkeys.UPLOAD_FORM_PASSWORD, "=\"\"",
            " -F ", formkeys.UPLOAD_FORM_FILE, "=\"data=@your_file_path.txt\"",
            )
        // wgetCmd := "wget -O /dev/null --content-disposition " + dl
    }}

    <br/>
    <h1>Other uploads</h1>
    <br/>
        
    <pre class="my-2" title="Curl command to download the file">
        <textarea class="w-full" rows="1">
            { curlCmd }
        </textarea>
    </pre>

    <!--
    <pre class="my-2" title="wget command to download the file">
        <textarea class="w-full whitespace-nowrap" rows="1">
            { wgetCmd }
        </textarea>
    </pre>
    -->
}

templ PageUpload(view *PageUploadView) {

    @Base() {

        <br/>
        <h1>Upload a file</h1>
        <h3>File must be less than { str.PrettyByteSize64(config.MaxUploadSize()) } </h3>
        <br/>

        <form enctype="multipart/form-data" action="/api/upload" method="POST">

            <table class="table-auto table-padded">

            <tbody class="text-right">

                <tr title="Expire after this many days">
                    <td class="px-2"> Days </td>
                    <td> <input type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_DAYS } value="0" min="0" required> </td>
                </tr>
                <tr title="Expire after this many hours">
                    <td class="px-2"> Hours </td>
                    <td> <input type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_HOURS } value="1" min="0" required> </td>
                </tr>
                <tr title="Expire after this many minutes">
                    <td class="px-2"> Minutes </td>
                    <td> <input type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_MINUTES } value="0" min="0" required> </td>
                </tr>
                <tr title="Expired after this many downloads">
                    <td class="px-2"> Downloads </td>
                    <td> <input type="number" name={ formkeys.UPLOAD_FORM_EXPIRE_DOWNLOADS } value="1" min="1" required> </td>
                </tr>
                <tr title="Require this password to download the file">
                    <td class="px-2"> Password (Optional) </td>
                    <td> <input type="password" name={ formkeys.UPLOAD_FORM_PASSWORD }> </td>
                </tr>
                <tr title="Choose the file to upload">
                    <td colspan="2"> 
                        <input class="w-full" type="file" name={ formkeys.UPLOAD_FORM_FILE } required>
                    </td>
                </tr>
                <tr title="Upload the selected file">
                    <td colspan="2"> 
                        <input class="w-full" type="submit" value="Upload">
                    </td>
                </tr>

            </tbody>

            </table>
                        
        </form>

        @e2eOptions(view)
    }
}

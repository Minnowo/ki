package pages

import(
    "ki/src/config"
    "ki/src/pkg/bytes"
    "ki/src/ui/formkeys"
    "ki/src/ui"
)

templ e2eOptions(view *PageUploadView) {

    <div class="surface-1 flex flex-col gap-4">
        <div>
            <h2>E2E options</h2>
            <small>Encrypt the file with a password before uploading it.</small>
        </div>

        <div class="flex flex-col gap-1" title="GPG command to encrypt a file with a password">
            <small>GPG</small>
            <pre><code>gpg -c your_file.txt</code></pre>
        </div>

        <div class="flex flex-col gap-1" title="7-Zip command to encrypt a file with a password">
            <small>7-Zip</small>
            <pre><code>7z a output.7z -pyour_password your_file.txt</code></pre>
        </div>
    </div>
}

templ PageUpload(view *PageUploadView) {

    @Base(&view.BaseView) {

        <div>
            <h1>Upload a file</h1>
            <small>File must be less than { bytes.PrettyByteSize64(config.MaxUploadSize()) }</small>
        </div>

        <div class="surface-1 flex flex-col gap-4">

            <form id="upload_form" class="flex flex-col gap-4" enctype="multipart/form-data" action="/api/ul/full" method="POST">

                @ui.CSRF(view.R)

                <div class="flex flex-col gap-2">
                    <h3>Expires after</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <label class="flex flex-col gap-1">
                            Days
                            <input type="number" title="Expire after this many days" name={ formkeys.UPLOAD_FORM_EXPIRE_DAYS } value="0" min="0" required/>
                        </label>
                        <label class="flex flex-col gap-1">
                            Hours
                            <input type="number" title="Expire after this many hours" name={ formkeys.UPLOAD_FORM_EXPIRE_HOURS } value="1" min="0" required/>
                        </label>
                        <label class="flex flex-col gap-1">
                            Minutes
                            <input type="number" title="Expire after this many minutes" name={ formkeys.UPLOAD_FORM_EXPIRE_MINUTES } value="0" min="0" required/>
                        </label>
                        <label class="flex flex-col gap-1">
                            Downloads
                            <input type="number" title="Expire after this many downloads" name={ formkeys.UPLOAD_FORM_EXPIRE_DOWNLOADS } value="1" min="1" required/>
                        </label>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="flex flex-col gap-1">
                        Memory only
                        <select title="Never write file metadata to disk (file will expire if server restarts or crashes)" name={ formkeys.UPLOAD_FORM_MEMORY_ONLY }>
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </label>
                    <label class="flex flex-col gap-1">
                        Password
                        <input type="password" title="Require this password to download the file" name={ formkeys.UPLOAD_FORM_PASSWORD } placeholder="Optional" autocomplete="new-password"/>
                    </label>
                    <label class="flex flex-col gap-1">
                        File
                        <input type="file" title="Choose the file to upload" name={ formkeys.UPLOAD_FORM_FILE } required/>
                    </label>
                </div>

                <div class="flex justify-end gap-2">
                    <button type="submit" class="btn-primary" title="Upload the selected file">Upload</button>
                </div>

            </form>

            <div id="mount" class="contents"></div>

        </div>

        @e2eOptions(view)

        <script>
            window.InitUpload(
                "mount",
                "upload_form",
                {{ config.MaxUploadSize() - config.KB }},
                {{ config.MaxChunkSize() - config.KB }}
            );
        </script>
    }
}

package pages

import (
    "ki/src/ui"
    "ki/src/ui/formkeys"
)

templ PageLogin(view *BaseView) {

    @Base(view) {

        <h1>Login to upload files</h1>

        <form class="surface-1 flex flex-col gap-4" enctype="multipart/form-data" action="/api/login" method="POST">

            @ui.CSRF(view.R)

            <div class="flex flex-col gap-2">
                <label class="flex flex-col gap-1">
                    Username
                    <input type="text" name={ formkeys.LOGIN_FORM_USERNAME } autocomplete="username" autofocus required/>
                </label>
                <label class="flex flex-col gap-1">
                    Password
                    <input type="password" name={ formkeys.LOGIN_FORM_PASSWORD } autocomplete="current-password" required/>
                </label>
            </div>

            <div class="flex justify-end gap-2">
                <button type="submit" class="btn-primary">Login</button>
            </div>

        </form>
    }
}

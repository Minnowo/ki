package pages

import (
    "ki/src/ui"
)


templ Base(view *BaseView) {

    <html>
    <head>
        @ui.HeadMetaData()
        @ui.CSSIncludeMain()
    </head>

    <body class="lg:p-32 md:p-16 p-8 bg-c-black text-c-white">

        @Header(view)

        <center>
            { children... }
        </center>

    </body>
    </html>
}
